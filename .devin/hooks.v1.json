{
  "SessionStart": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "node \"hooks/jbcontext/jbcontext-devin.js\" SessionStart",
          "timeout": 10
        }
      ]
    }
  ],
  "PostCompaction": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "node \"hooks/jbcontext/jbcontext-devin.js\" PostCompaction",
          "timeout": 2
        }
      ]
    }
  ],
  "PreToolUse": [
    {
      "matcher": "mcp__jbcontext__code_search|grep|glob|find_file_by_name|exec",
      "hooks": [
        {
          "type": "command",
          "command": "node \"hooks/jbcontext/jbcontext-devin.js\" PreToolUse",
          "timeout": 2
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "node \"hooks/jbcontext/jbcontext-devin.js\" UserPromptSubmit",
          "timeout": 2
        }
      ]
    }
  ]
}
